# Copy to .env.local and fill in. With NO values set, the app runs in DEMO MODE:
# in-memory data (resets on restart) and a keyword-based mock classifier.

# --- AI classifier -----------------------------------------------------------
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Model id exactly as shown in Google AI Studio. Use a Gemma 4 variant ONLY if it
# accepts image input; otherwise use a Gemini model and say so in your submission.
AI_MODEL=

# --- Supabase (optional; omit to use the in-memory demo store) ----------------
SUPABASE_URL=
# Server-side only. Never expose this in client code or commit it.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PHOTO_BUCKET=report-photos
