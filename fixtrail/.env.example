# Copy to .env.local and fill in. With NO values set, the app runs in DEMO MODE:
# in-memory data (resets on restart) and a keyword-based mock classifier.

# --- AI classifier -----------------------------------------------------------
# Create an API key in the Anthropic Console. Keep it server-side; never prefix
# this with NEXT_PUBLIC_.
ANTHROPIC_API_KEY=
# Claude model ID from https://platform.claude.com/docs/en/models/overview
# Haiku is a fast, lower-cost fit for classification; use an ID your account can access.
AI_MODEL=claude-haiku-5-5

# --- Supabase (optional; omit to use the in-memory demo store) ----------------
SUPABASE_URL=
# Server-side only. Never expose this in client code or commit it.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PHOTO_BUCKET=report-photos
