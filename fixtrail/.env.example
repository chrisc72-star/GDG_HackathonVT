# Team: Chris and Shruti
# GDG Hackathon 2026
# This file documents the environment variables used to run FixTrail. It groups Supabase, authentication, admin, and optional AI classifier settings without exposing real secrets.

# Copy to .env.local and fill in to enable sign-in and persistent application data.

# --- Supabase Auth and database ----------------------------------------------
SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
# Supabase publishable key (or legacy anon key). Safe for browser use with RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-side only. Never expose this in client code or commit it.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PHOTO_BUCKET=report-photos
# Comma-separated verified @vt.edu accounts allowed to use /admin.
ADMIN_EMAILS=

# --- AI classifier (Gemma 4 through Google AI Studio) ------------------------
# Create a key at https://aistudio.google.com/apikey. Keep it server-side;
# never prefix it with NEXT_PUBLIC_.
GEMINI_API_KEY=
GEMINI_MODEL=gemma-4-26b-a4b-it
